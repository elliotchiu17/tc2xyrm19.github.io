rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // 第一次登入後，將下方字串替換為 Google 登入產生的完整 Firebase UID。
      // 未替換前任何登入者都沒有寫入權限，千萬不要改成 request.auth != null。
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_YOUR_FIREBASE_UID';
    }
    match /public_articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /articles/{articleId} {
      allow read, write: if isAdmin();
    }
    match /settings/catalog {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /admin_probe/{probeId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // 其他所有路徑一律沒有權限。
  }
}
